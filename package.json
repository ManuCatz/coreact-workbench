{
  "name": "coreact2",
  "version": "1.0.0",
  "description": "JS library for drawing SVG shapes, with data. API based on d3.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sorts": "tsc src/default_sorts.ts --target esnext --moduleResolution node --outDir public",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/d3": "^7.4.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "d3": "^7.8.0",
    "puppeteer": "^24.43.1"
  }
}
